<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A111E"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainCadastro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgLogoLogin"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="Logo NENGUE Barbearia"
            android:scaleType="fitCenter"
            android:src="@drawable/nengue_logo" />

        <TextView
            android:id="@+id/tvTituloCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp"
            android:fontFamily="@font/rye"
            android:gravity="center"
            android:text="Crie sua Conta"
            android:textAllCaps="true"
            android:textColor="#D5E7F0"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome Completo"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNomeCadastro"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fundo_campo_texto"
            android:backgroundTint="@null"
            android:hint="Seu nome completo"
            android:inputType="textPersonName"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#D5E7F0"
            android:textColorHint="#8A92A6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmailCadastro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fundo_campo_texto"
            android:backgroundTint="@null"
            android:hint="Digite seu e-mail"
            android:inputType="textEmailAddress"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#D5E7F0"
            android:textColorHint="#8A92A6" />

        <!-- Telefone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone / Celular"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTelefoneCadastro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fundo_campo_texto"
            android:backgroundTint="@null"
            android:hint="(47) 90000-0000"
            android:inputType="phone"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#D5E7F0"
            android:textColorHint="#8A92A6" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data de Nascimento"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDataNascimentoCadastro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fundo_campo_texto"
            android:backgroundTint="@null"
            android:hint="DD/MM/AAAA"
            android:inputType="date"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#D5E7F0"
            android:textColorHint="#8A92A6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senha"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- mostrar/esconder senha-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/fundo_campo_texto"
                android:backgroundTint="@null"
                android:hint="Crie uma senha"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="45dp"
                android:textColor="#D5E7F0"
                android:textColorHint="#8A92A6" />

            <ImageView
                android:id="@+id/btnVerSenhaCadastro"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:contentDescription="Mostrar ou ocultar senha"
                android:src="@android:drawable/ic_secure" />

        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Senha"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/etConfirmarSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/fundo_campo_texto"
                android:backgroundTint="@null"
                android:hint="Repita a senha"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="45dp"
                android:textColor="#D5E7F0"
                android:textColorHint="#8A92A6" />

            <ImageView
                android:id="@+id/btnVerConfirmarSenhaCadastro"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:contentDescription="Mostrar ou ocultar senha"
                android:src="@android:drawable/ic_secure" />

        </RelativeLayout>

        <Button
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#2142B2"
            android:text="Cadastrar"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvVoltarLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>