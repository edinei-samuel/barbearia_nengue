<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCliente"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/vascaino_da_navalha"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.Users.Circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Michel"
                android:textColor="#4285F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServicoCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cabelo + Barba"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHorarioCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:55"
            android:textColor="#4285F4"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="#4285F4" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>