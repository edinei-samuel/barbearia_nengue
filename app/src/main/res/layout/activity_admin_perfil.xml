<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#111B27"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Perfil do Barbeiro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnEditarPerfil"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="Editar Perfil"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- CONTEÚDO ROLÁVEL (Apenas as informações do perfil rolam) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFotoPerfilView"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="#E0E0E0"
                    android:scaleType="centerCrop"
                    android:src="@drawable/vascaino_da_navalha"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.Users.Circle" />

                <TextView
                    android:id="@+id/tvNomeExibicao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Vascaino da Navalha"
                    android:textColor="#111B27"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textColor="#222222"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmailView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="vascaino@barbearia.com"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telefone / Whatsapp"
                android:textColor="#222222"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTelefoneView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="(47) 98812-3456"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data de Nascimento"
                android:textColor="#222222"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDataNascimentoView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="02 / 05 / 1999"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumo"
                android:textColor="#222222"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExperienciaView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="Breve resumo sobre o barbeiro..."
                android:textColor="#555555"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

    <!-- ÁREA FIXA NO RODAPÉ (Botões Editar e Sair da Conta) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F6F9"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Editar Informações"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#0E5E58"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSairConta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Sair da Conta"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <include layout="@layout/barra_navegar" />

</LinearLayout>